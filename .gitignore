# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/

# Ignore the directory for local files during development
local/

# Ignore the Gemfile that is generated
Gemfile.lock

# Ignore files created by npm
node_modules
package-lock.json

# Ignore the vendor file and bundle for alternative installation
/vendor/
.bundle/

# Jekyll incremental build cache.
/.jekyll-cache/
/.jekyll-metadata

# Package manager debug logs.
npm-debug.log*
yarn-error.log*

# Local Python environments and bytecode.
__pycache__/
*.pyc
.venv/

# OS and editor temporary files.
.DS_Store
Thumbs.db
*.swp
*.swo
*~
